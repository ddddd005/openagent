    "command_result_payload": {
      "type": "object",
      "required": [
        "command_id",
        "target",
        "status",
        "reason_code"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "format": "uuid4",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "minLength": 36,
          "maxLength": 36
        },
        "target": {
          "type": "object",
          "required": [
            "workflow_session_id",
            "node_binding_id",
            "run_id"
          ],
          "properties": {
            "workflow_session_id": {
              "type": "string",
              "format": "uuid4",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "minLength": 36,
              "maxLength": 36
            },
            "node_binding_id": {
              "type": "string",
              "format": "uuid4",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "minLength": 36,
              "maxLength": 36
            },
            "run_id": {
              "type": "string",
              "format": "uuid4",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
              "minLength": 36,
              "maxLength": 36
            }
          },
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*(?![\\s\\S])",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
