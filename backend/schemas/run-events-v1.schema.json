    "run_state_payload": {
      "type": "object",
      "required": [
        "previous_status",
        "status",
        "phase",
        "available_actions",
        "action_rejections",
        "reason_code"
      ],
      "properties": {
        "previous_status": {
          "anyOf": [
            {
              "enum": [
                "prepared",
                "running",
                "pausing",
                "paused",
                "failed",
                "final_ready",
                "succeeded",
                "superseded",
                "recovery_unavailable",
                "closed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "prepared",
            "running",
            "pausing",
            "paused",
            "failed",
            "final_ready",
            "succeeded",
            "superseded",
            "recovery_unavailable",
            "closed"
          ]
        },
        "phase": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*(?![\\s\\S])",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "available_actions": {
          "type": "array",
          "items": {
            "enum": [
              "pause",
              "resume",
              "reroll",
              "retry_archive",
              "extend_budget",
              "close_execution",
              "continue_workflow"
            ]
          },
          "uniqueItems": true
        },
        "action_rejections": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "pause",
              "resume",
              "reroll",
              "retry_archive",
              "extend_budget",
              "close_execution",
              "continue_workflow"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*(?![\\s\\S])",
            "maxLength": 128
          }
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*(?![\\s\\S])",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
